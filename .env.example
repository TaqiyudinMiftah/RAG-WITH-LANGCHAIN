# Google Gemini API Key (FREE)
# Get your key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# PostgreSQL Database URL for Chat History
# Format: postgresql://username:password@host:port/database
# For local PostgreSQL: postgresql://postgres:password@localhost:5432/rag_chat
# For cloud PostgreSQL (e.g., Supabase, Railway, etc.): use provided connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/rag_chat

# Optional: OpenAI API Key
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your-openai-key-here

# Optional: HuggingFace API Key (FREE)
# Get your key from: https://huggingface.co/settings/tokens
# HUGGINGFACE_API_KEY=your-hf-key-here
